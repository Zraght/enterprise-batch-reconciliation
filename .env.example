# =====================================================================================================
# Example configuration. Copy to ".env" and fill in your own values. NEVER commit ".env".
# Spring Boot does not read .env files by itself: export the variables (see README) or define them in
# your IDE run configuration.  Placeholders below are NOT real credentials.
# =====================================================================================================

# ---- Application database connection --------------------------------------------------------------
DB_URL=jdbc:sqlserver://localhost:1433;databaseName=ReconciliationDB;encrypt=true;trustServerCertificate=true
DB_USERNAME=reconciliation_app
DB_PASSWORD=<choose-a-strong-password>
DB_POOL_SIZE=16

# ---- API protection -----------------------------------------------------------------------------------
# Shared secret expected in the X-API-Key header. MANDATORY with SPRING_PROFILES_ACTIVE=prod (the application refuses to
# start without it); at least 16 characters. Blank = authentication disabled (local development only).
API_KEY=<generate-a-long-random-value>

# ---- Reconciliation policy ------------------------------------------------------------------------------
# How long after booking a gateway may take to settle (ISO-8601 duration). A ledger movement is reported as "missing from the
# file" only once the file's settlement period extends past booking time + this lag. PT0S = same day, P1D = T+1 (default).
RECONCILIATION_SETTLEMENT_LAG=P1D

# ---- Runtime ----------------------------------------------------------------------------------------
# No profile is active by default. dev and test enable the synthetic-data (seed) endpoint; prod does not.
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080
RECONCILIATION_STORAGE_DIR=./data/uploads
UPLOAD_MAX_FILE_SIZE=512MB
LOG_DIR=./logs

# ---- Only used by docker-compose.yml (local SQL Server) ---------------------------------------------
# SA_PASSWORD must satisfy the SQL Server policy: >= 8 chars with upper, lower, digit and symbol.
SA_PASSWORD=<choose-a-strong-sa-password>
# Password given to the application login created by database/01_create_database.sql
DB_APP_PASSWORD=<same-value-as-DB_PASSWORD>
